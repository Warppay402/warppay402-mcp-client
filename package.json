{
  "name": "@warppay402/mcp-client",
  "version": "1.1.0",
  "description": "Stdio-to-SSE bridge for WarpPay402 MCP Gateway with automated x402 payment signing and autonomous multi-agent workflows.",
  "main": "dist/mcp-client.js",
  "type": "module",
  "bin": {
    "warppay402-mcp": "dist/mcp-client.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Warppay402/warppay-mcp-client.git"
  },
  "bugs": {
    "url": "https://github.com/Warppay402/warppay-mcp-client/issues"
  },
  "homepage": "https://www.warppay402.com",
  "openclaw": {
    "extensions": [
      "./dist/mcp-client.js"
    ],
    "compat": {
      "pluginApi": ">=2026.1.0"
    },
    "build": {
      "openclawVersion": "2026.1.0"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@warppay402/sdk": "^1.4.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
